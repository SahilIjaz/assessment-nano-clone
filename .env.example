# Copy this file to .env.local and fill in what you use. Everything is optional: each feature has a local fallback.
# Never put real secrets in this file — .env.local is git-ignored, .env.example is not.

# ── Database ──────────────────────────────────────────────────────────────────
# Leave empty locally (a SQLite file at ./data/naano.db is used). On Vercel set a Turso database (https://turso.tech):
#   turso db create naano && turso db show naano --url && turso db tokens create naano
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── AI ────────────────────────────────────────────────────────────────────────
# Powers website analysis during brand onboarding, Nao creator matching, "Create with AI" briefs and the NaanoBot assistant.
# AI_PROVIDER: gemini | anthropic | auto (auto = Gemini if GEMINI_API_KEY is set, otherwise Anthropic if ANTHROPIC_API_KEY is set).
AI_PROVIDER=auto
# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Anthropic Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Set to 1 to force the deterministic fallbacks even when a key is present.
NAANO_DISABLE_AI=

# ── E-mail ────────────────────────────────────────────────────────────────────
# Verification / recovery codes. MAIL_PROVIDER: smtp | resend | auto (auto = SMTP if SMTP_HOST is set, otherwise Resend if RESEND_API_KEY is set).
# With neither configured, messages stay in the local inbox at /dev/inbox.
MAIL_PROVIDER=auto
MAIL_FROM="Naano <no-reply@yourdomain.com>"
# SMTP via nodemailer. Gmail: host smtp.gmail.com, port 587, user = your address, pass = an App Password (https://myaccount.google.com/apppasswords).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Set to 1 only for implicit TLS (port 465). Leave empty for port 587 (STARTTLS).
SMTP_SECURE=
# Resend — https://resend.com/api-keys (verify your sending domain under Domains).
RESEND_API_KEY=

# ── Social sign-in (OpenID Connect) ───────────────────────────────────────────
# Register the callback URL  <APP_URL>/api/auth/oauth/callback  with each provider.
# Leave empty to use the built-in local consent screen that simulates the provider.
APP_URL=http://localhost:3000
# Google — https://console.cloud.google.com/apis/credentials (OAuth client ID, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# LinkedIn — https://www.linkedin.com/developers/apps (enable "Sign In with LinkedIn using OpenID Connect")
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
